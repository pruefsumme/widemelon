pkgbase = widemelon-bin
	pkgdesc = Widescreen Nintendo DS emulator based on melonDS (AppImage)
	pkgver = @VERSION@
	pkgrel = 1
	url = https://github.com/pruefsumme/widemelon
	arch = x86_64
	license = GPL-3.0-or-later
	depends = fuse2
	provides = widemelon
	conflicts = widemelon
	conflicts = widemelon-git
	options = !strip
	options = !debug
	source = WideMelon-@VERSION@-x86_64.AppImage::https://github.com/pruefsumme/widemelon/releases/download/v@VERSION@/WideMelon-@VERSION@-x86_64.AppImage
	sha256sums = @APPIMAGE_SHA256@

pkgname = widemelon-bin
