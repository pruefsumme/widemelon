+  line-height: 1;
+  opacity: .65;
+  touch-action: none;
+  -webkit-tap-highlight-color: transparent;
+}
+
+#dpad::before, #dpad::after {
+  content: "";
+  position: absolute;
+  background: linear-gradient(145deg, #ededed, #adadad);
+  border: 1px solid rgba(255, 255, 255, .32);
+  box-shadow:
