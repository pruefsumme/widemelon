+  pointer-events: none;
+}
+
+#status, #metrics {
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+#metrics {
+  color: rgba(255, 255, 255, .34);
+  font: 9px/1 monospace;
+}
