+  top: 19%;
+  width: 62%;
+  height: 62%;
+  z-index: 3;
+  border: 1px solid rgba(255, 255, 255, .44);
+  background: radial-gradient(circle at 38% 30%, #ededed 0, #c6c6c6 58%, #a0a0a0 100%);
