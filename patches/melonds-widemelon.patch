+}
+
+button.active, button:active {
+  opacity: .82;
+  background: linear-gradient(145deg, #ababab, #e1e1e1);
+  box-shadow: inset 0 2px 3px rgba(0, 0, 0, .28), 0 1px 2px rgba(0, 0, 0, .45);
+  transform: translateY(1px);
+}
+
+#hud {
+  position: fixed;
+  z-index: 3;
+  top: max(8px, env(safe-area-inset-top));
+  left: max(10px, env(safe-area-inset-left));
+  max-width: 72vw;
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  overflow: hidden;
+  color: rgba(255, 255, 255, .48);
+  font-size: 11px;
+  line-height: 1;
