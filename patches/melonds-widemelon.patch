+
+.face-button.x { left: 32%; top: 0; }
+.face-button.y { left: 0; top: 32%; }
+.face-button.a { right: 0; top: 32%; }
+.face-button.b { left: 32%; bottom: 0; }
+
+.small {
+  min-width: 0;
+  min-height: 0;
+  padding: 0 8px;
+  border-radius: 8px;
+  font-size: 9px;
+  font-weight: 500;
+  letter-spacing: .04em;
+}
+
+#screen {
+  display: block;
+  z-index: 0;
+  background: #000;
+  border: 2px solid rgba(255, 255, 255, .16);
+  border-radius: 4px;
