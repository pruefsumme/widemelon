+  <link rel="stylesheet" href="app.css">
+</head>
+<body>
+  <div id="hud">
+    <span id="status" role="status" aria-live="polite">Connecting…</span>
+    <span id="metrics">Waiting for video</span>
+  </div>
+  <button id="fullscreen" aria-label="Enter full screen" title="Full screen">
+    <svg viewBox="0 0 18 18" aria-hidden="true">
+      <path d="M10.5 3H15v4.5M7.5 15H3v-4.5" />
+    </svg>
+  </button>
+  <main id="controller">
+    <canvas id="screen" data-layout-id="screen" width="256" height="192" aria-label="Nintendo DS bottom screen"></canvas>
+    <button class="shoulder" data-layout-id="l" data-button="9">L</button>
+    <button class="shoulder" data-layout-id="r" data-button="8">R</button>
+    <div id="dpad" data-layout-id="dpad" aria-label="Directional pad">
+      <span class="up">▲</span><span class="left">◀</span>
+      <span class="right">▶</span><span class="down">▼</span>
+      <span class="pivot"></span>
+    </div>
+    <div id="face" data-layout-id="face" aria-label="ABXY buttons">
+      <button class="face-button x" data-button="10">X</button>
+      <button class="face-button y" data-button="11">Y</button>
+      <button class="face-button a" data-button="0">A</button>
+      <button class="face-button b" data-button="1">B</button>
+    </div>
+    <button class="small" data-layout-id="select" data-button="2">Select</button>
+    <button class="small" data-layout-id="start" data-button="3">Start</button>
+  </main>
+  <div id="rotate">Rotate your phone to landscape for the full controller.</div>
+  <script src="app.js"></script>
+</body>
+</html>
